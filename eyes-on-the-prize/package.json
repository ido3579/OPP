{
  "name": "eyes-on-the-prize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eyes-on-the-prize",
    "productName": "Eyes on the Prize",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "public/tray-icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/tray-icon.png"
    },
    "linux": {
      "target": "deb",
      "icon": "public/tray-icon.png"
    }
  }
}
